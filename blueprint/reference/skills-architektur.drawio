<mxfile host="app.diagrams.net" agent="project-pilot" version="24.0.0">

  <diagram id="prinzip" name="1 - Prinzip">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />

        <mxCell id="T" value="Skills geben dem Agenten &lt;b&gt;Urteilsverm&#246;gen&lt;/b&gt;. MCP gibt ihm &lt;b&gt;Zugriff&lt;/b&gt;. Code beh&#228;lt, was nie ein LLM entscheiden darf." style="text;html=1;align=center;fontSize=17;fontStyle=2;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1520" height="30" as="geometry" /></mxCell>

        <mxCell id="KA" value="A&#160;&#160;DETERMINISTISCHER KERN&#160;&#8212;&#160;bleibt Python" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#546E7A;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=13;fontStyle=1;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="460" height="540" as="geometry" /></mxCell>
        <mxCell id="KB" value="B&#160;&#160;MCP-SERVER&#160;&#8212;&#160;der Zugriff" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=13;fontStyle=1;fontColor=#1B5E20;" vertex="1" parent="1"><mxGeometry x="570" y="90" width="440" height="540" as="geometry" /></mxCell>
        <mxCell id="KC" value="C&#160;&#160;SKILLS&#160;&#8212;&#160;das Urteil" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#EF6C00;dashed=0;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=13;fontStyle=1;fontColor=#E65100;" vertex="1" parent="1"><mxGeometry x="1080" y="90" width="480" height="540" as="geometry" /></mxCell>

        <mxCell id="a1" value="Scan &amp; Pagination (Watermark)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFD8DC;strokeColor=#546E7A;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="140" width="400" height="42" as="geometry" /></mxCell>
        <mxCell id="a2" value="Dedupe &#252;ber url_hash" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFD8DC;strokeColor=#546E7A;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="192" width="400" height="42" as="geometry" /></mxCell>
        <mxCell id="a3" value="Freshness-Gate + Hard Rules (0 Token)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFD8DC;strokeColor=#546E7A;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="244" width="400" height="42" as="geometry" /></mxCell>
        <mxCell id="a4" value="PostgreSQL &#183; Migrationen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFD8DC;strokeColor=#546E7A;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="296" width="400" height="42" as="geometry" /></mxCell>
        <mxCell id="a5" value="SMTP-Versand + Doppelversand-Guard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFD8DC;strokeColor=#546E7A;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="348" width="400" height="42" as="geometry" /></mxCell>
        <mxCell id="a6" value="robots.txt-Gate &#183; 403-Cooldown &#183; Retry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFD8DC;strokeColor=#546E7A;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="400" width="400" height="42" as="geometry" /></mxCell>
        <mxCell id="aN" value="&lt;b&gt;Warum kein Skill?&lt;/b&gt;&lt;br&gt;Nie ein LLM entscheiden lassen, ob ein Listing schon bekannt ist oder eine Mail schon raus war. Das muss jedes Mal gleich ausgehen &#8212; das ist Code, kein Prompt." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="70" y="462" width="400" height="130" as="geometry" /></mxCell>

        <mxCell id="b1" value="get_listing &#183; search_listings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#388E3C;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="140" width="380" height="42" as="geometry" /></mxCell>
        <mxCell id="b2" value="save_evaluation &#183; set_status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#388E3C;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="192" width="380" height="42" as="geometry" /></mxCell>
        <mxCell id="b3" value="ingest_listing (idempotent)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#388E3C;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="244" width="380" height="42" as="geometry" /></mxCell>
        <mxCell id="b4" value="save_draft &#183; send_application" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#388E3C;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="296" width="380" height="42" as="geometry" /></mxCell>
        <mxCell id="b5" value="enrich_company &#183; get_profile" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#388E3C;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="348" width="380" height="42" as="geometry" /></mxCell>
        <mxCell id="bN" value="&lt;b&gt;Ein FastMCP-Server &#252;ber deine bestehenden Services.&lt;/b&gt;&lt;br&gt;Das ist deine einzige Schnittstelle &#8212; keine REST-API, sondern das Protokoll, das jeder Agent schon spricht." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="600" y="410" width="380" height="90" as="geometry" /></mxCell>

        <mxCell id="c1" value="&lt;b&gt;check-project&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Wie bewerte ich ein Angebot gegen Niks Profil?&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCC80;strokeColor=#E65100;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1110" y="140" width="420" height="52" as="geometry" /></mxCell>
        <mxCell id="c2" value="&lt;b&gt;write-application&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Ton, Aufbau, was rein muss, was nie&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCC80;strokeColor=#E65100;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1110" y="202" width="420" height="52" as="geometry" /></mxCell>
        <mxCell id="c3" value="&lt;b&gt;research-company&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Wo suche ich, was ist ein guter Treffer&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCC80;strokeColor=#E65100;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1110" y="264" width="420" height="52" as="geometry" /></mxCell>
        <mxCell id="c4" value="&lt;b&gt;linkedin-outreach&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Vernetzungsnachricht, &#8804;300 Zeichen&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCC80;strokeColor=#E65100;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1110" y="326" width="420" height="52" as="geometry" /></mxCell>
        <mxCell id="cN" value="&lt;b&gt;Markdown, kein Code.&lt;/b&gt; Frontmatter (name + description) plus Anleitung. Nik editiert sie selbst.&lt;br&gt;&lt;br&gt;&lt;b&gt;Kosten pro Skill: ~100 Token&lt;/b&gt;, bis er ausgel&#246;st wird &#8212; erst dann l&#228;dt der Body. Darum sind viele Skills billig, viele MCP-Tools aber teuer." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1110" y="392" width="420" height="120" as="geometry" /></mxCell>

        <mxCell id="WARN" value="HARTE GRENZE&#160;&#160;&#183;&#160;&#160;Skills auf der Claude API laufen in einer Sandbox &lt;b&gt;ohne Netzzugang&lt;/b&gt; und ohne Paketinstallation.&#160;&#160;&#8658;&#160;&#160;Alles, was Daten holt oder schreibt, MUSS ein MCP-Tool sein. Ein Skill, der selbst die DB lesen will, funktioniert dort nicht." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;fontSize=13;fontColor=#B71C1C;" vertex="1" parent="1"><mxGeometry x="40" y="670" width="1520" height="60" as="geometry" /></mxCell>

        <mxCell id="ARR1" value="ruft auf" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#E65100;endArrow=block;strokeWidth=3;fontSize=12;fontStyle=1;" edge="1" parent="1" source="KC" target="KB"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ARR2" value="ruft auf" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#388E3C;endArrow=block;strokeWidth=3;fontSize=12;fontStyle=1;" edge="1" parent="1" source="KB" target="KA"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="verteilung" name="2 - Verteilung">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />

        <mxCell id="VT" value="Eine Quelle, sechs Oberfl&#228;chen &#8212; aber nur drei davon holen sich die Skills von selbst." style="text;html=1;align=center;fontSize=17;fontStyle=2;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1520" height="30" as="geometry" /></mxCell>

        <mxCell id="SRC" value="&lt;b&gt;project-pilot Repo&lt;/b&gt;&lt;br&gt;&lt;br&gt;.claude/skills/&lt;br&gt;&#160;&#160;check-project/SKILL.md&lt;br&gt;&#160;&#160;write-application/SKILL.md&lt;br&gt;&#160;&#160;research-company/SKILL.md&lt;br&gt;&#160;&#160;linkedin-outreach/SKILL.md&lt;br&gt;&lt;br&gt;&lt;i&gt;genau eine Ebene tief&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=3;fontSize=13;align=left;spacingLeft=16;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="80" y="290" width="330" height="240" as="geometry" /></mxCell>

        <mxCell id="AUTO" value="AUTOMATISCH &#8212; kein Upload, kein Sync" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=13;fontStyle=1;fontColor=#1B5E20;" vertex="1" parent="1"><mxGeometry x="600" y="100" width="940" height="290" as="geometry" /></mxCell>
        <mxCell id="v1" value="&lt;b&gt;Claude Code (lokal)&lt;/b&gt;&lt;br&gt;liest .claude/skills direkt vom Dateisystem" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#388E3C;fontSize=12;" vertex="1" parent="1"><mxGeometry x="630" y="150" width="420" height="60" as="geometry" /></mxCell>
        <mxCell id="v2" value="&lt;b&gt;Managed-Agent Session&lt;/b&gt;&lt;br&gt;Repo als github_repository gemountet &#8594; Scan beim Sessionstart" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#388E3C;fontSize=12;" vertex="1" parent="1"><mxGeometry x="630" y="220" width="420" height="60" as="geometry" /></mxCell>
        <mxCell id="v3" value="&lt;b&gt;Claude Code Routine&lt;/b&gt;&lt;br&gt;Repo ist Teil der Routine-Konfiguration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#388E3C;fontSize=12;" vertex="1" parent="1"><mxGeometry x="630" y="290" width="420" height="60" as="geometry" /></mxCell>
        <mxCell id="v4" value="&lt;b&gt;Codex &#183; Cursor &#183; andere&lt;/b&gt;&lt;br&gt;SKILL.md ist ein offener Standard &#8212; dieselbe Datei" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#388E3C;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1080" y="150" width="430" height="60" as="geometry" /></mxCell>
        <mxCell id="vN" value="&lt;b&gt;Das ist der Kern des Ansatzes:&lt;/b&gt; ein Ordner im Repo, versioniert in git, per Pull Request &#228;nderbar &#8212; und drei Laufzeiten holen ihn sich von allein." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1080" y="220" width="430" height="130" as="geometry" /></mxCell>

        <mxCell id="MAN" value="UPLOAD N&#214;TIG &#8212; Skills syncen NICHT zwischen Oberfl&#228;chen" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=13;fontStyle=1;fontColor=#B71C1C;" vertex="1" parent="1"><mxGeometry x="600" y="430" width="940" height="290" as="geometry" /></mxCell>
        <mxCell id="v5" value="&lt;b&gt;Claude API / Messages&lt;/b&gt;&lt;br&gt;POST /v1/skills &#8212; als CI-Job bei jedem Push" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#C62828;fontSize=12;" vertex="1" parent="1"><mxGeometry x="630" y="480" width="420" height="60" as="geometry" /></mxCell>
        <mxCell id="v6" value="&lt;b&gt;claude.ai &#183; Cowork&lt;/b&gt;&lt;br&gt;ZIP hochladen unter Settings &#8250; Features&lt;br&gt;&lt;i&gt;pro Nutzer, nicht zentral verwaltbar&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#C62828;fontSize=12;" vertex="1" parent="1"><mxGeometry x="630" y="550" width="420" height="70" as="geometry" /></mxCell>
        <mxCell id="mN" value="&lt;b&gt;Der eine Sync-Job, den du bauen musst.&lt;/b&gt;&lt;br&gt;&lt;br&gt;GitHub Action bei jedem Push auf main:&lt;br&gt;&#160;&#160;&#160;ant skills create --file skill.zip&lt;br&gt;&lt;br&gt;Damit bleibt die API-Seite automatisch aktuell. claude.ai bleibt manuell &#8212; das ist der Preis." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1080" y="480" width="430" height="180" as="geometry" /></mxCell>

        <mxCell id="ve1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#388E3C;endArrow=block;strokeWidth=3;" edge="1" parent="1" source="SRC" target="AUTO"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ve2" value="CI-Job" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C62828;endArrow=block;strokeWidth=3;dashed=1;fontSize=12;fontStyle=1;fontColor=#B71C1C;" edge="1" parent="1" source="SRC" target="MAN"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="n8nN" value="&lt;b&gt;Und n8n?&lt;/b&gt;&#160;&#160;n8n kennt keine Skills &#8212; die leben auf der Anthropic-Seite. Ein n8n-Workflow ruft per HTTP Request eine &lt;b&gt;Managed-Agent Session&lt;/b&gt; auf, und die bringt Skills und MCP schon mit. Du baust f&#252;r n8n also gar nichts Eigenes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;fontSize=12;align=left;spacingLeft=12;fontColor=#0D47A1;" vertex="1" parent="1"><mxGeometry x="80" y="600" width="330" height="180" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="ablauf" name="3 - Ablauf">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="880" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />

        <mxCell id="LA" value="WEG 1&#160;&#160;&#183;&#160;&#160;Der Scan findet ein Projekt" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#B0BEC5;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="1520" height="360" as="geometry" /></mxCell>

        <mxCell id="w1" value="Scheduler&lt;br&gt;alle 15 Min" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFD8DC;strokeColor=#546E7A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="110" width="150" height="60" as="geometry" /></mxCell>
        <mxCell id="w2" value="&lt;b&gt;Code&lt;/b&gt;&lt;br&gt;Dedupe &#183; Freshness&lt;br&gt;Hard Rules" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFD8DC;strokeColor=#546E7A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="110" width="150" height="60" as="geometry" /></mxCell>
        <mxCell id="w3" value="&lt;b&gt;Skill&lt;/b&gt;&lt;br&gt;check-project" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCC80;strokeColor=#E65100;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="110" width="150" height="60" as="geometry" /></mxCell>
        <mxCell id="w4" value="&lt;b&gt;MCP&lt;/b&gt;&lt;br&gt;save_evaluation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#388E3C;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="650" y="110" width="150" height="60" as="geometry" /></mxCell>
        <mxCell id="w5" value="PostgreSQL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFD8DC;strokeColor=#546E7A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="840" y="110" width="150" height="60" as="geometry" /></mxCell>
        <mxCell id="w6" value="&lt;b&gt;ntfy&lt;/b&gt;&lt;br&gt;Push aufs Handy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B3E5FC;strokeColor=#0277BD;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1030" y="110" width="150" height="60" as="geometry" /></mxCell>
        <mxCell id="w7" value="&lt;b&gt;Nik tippt&lt;/b&gt;&lt;br&gt;auf die Notification" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1220" y="110" width="150" height="60" as="geometry" /></mxCell>

        <mxCell id="w8" value="&lt;b&gt;Thread &#246;ffnet sich&lt;/b&gt; &#8212; erst JETZT entsteht die Session&lt;br&gt;&lt;i&gt;Skills aus dem Repo + project-pilot MCP schon dabei&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0277BD;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="460" y="235" width="530" height="60" as="geometry" /></mxCell>
        <mxCell id="w9" value="&#8222;Schreib die Bewerbung&#8220;&lt;br&gt;&#8594; Skill &lt;b&gt;write-application&lt;/b&gt; &#8594; MCP &lt;b&gt;save_draft&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontSize=12;" vertex="1" parent="1"><mxGeometry x="460" y="315" width="330" height="55" as="geometry" /></mxCell>
        <mxCell id="w10" value="Nik best&#228;tigt&lt;br&gt;&#8594; MCP &lt;b&gt;send_application&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;fontSize=12;" vertex="1" parent="1"><mxGeometry x="840" y="315" width="330" height="55" as="geometry" /></mxCell>

        <mxCell id="LB" value="WEG 2&#160;&#160;&#183;&#160;&#160;n8n &#8212; dieselben Skills, ohne dass du f&#252;r n8n etwas baust" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#90CAF9;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#0D47A1;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="1520" height="230" as="geometry" /></mxCell>

        <mxCell id="x1" value="Gmail Trigger&lt;br&gt;&#8222;Projektangebote&#8220;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1976D2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="510" width="170" height="60" as="geometry" /></mxCell>
        <mxCell id="x2" value="&lt;b&gt;HTTP Request&lt;/b&gt;&lt;br&gt;POST /v1/sessions&lt;br&gt;&lt;i&gt;agent = project-pilot&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1976D2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="510" width="170" height="60" as="geometry" /></mxCell>
        <mxCell id="x3" value="&#8222;Pr&#252;fe dieses Angebot:&lt;br&gt;&lt;i&gt;{mail body}&lt;/i&gt;&#8220;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1976D2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="520" y="510" width="170" height="60" as="geometry" /></mxCell>
        <mxCell id="x4" value="&lt;b&gt;Skill&lt;/b&gt;&lt;br&gt;check-project&lt;br&gt;&lt;i&gt;derselbe wie oben&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCC80;strokeColor=#E65100;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="740" y="510" width="170" height="60" as="geometry" /></mxCell>
        <mxCell id="x5" value="&lt;b&gt;MCP&lt;/b&gt;&lt;br&gt;ingest_listing&lt;br&gt;save_evaluation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#388E3C;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="960" y="510" width="170" height="60" as="geometry" /></mxCell>
        <mxCell id="x6" value="landet im selben Feed&lt;br&gt;&#8594; Push &#8594; Thread" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B3E5FC;strokeColor=#0277BD;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1180" y="510" width="170" height="60" as="geometry" /></mxCell>
        <mxCell id="xN" value="Der Skill wei&#223; nicht und muss nicht wissen, ob der Text aus dem Scraper, aus einer Mail oder aus deinem Terminal kam. Genau das macht ihn wiederverwendbar." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="300" y="595" width="830" height="50" as="geometry" /></mxCell>

        <mxCell id="LC" value="Beide Wege benutzen &lt;b&gt;dieselbe SKILL.md&lt;/b&gt; und &lt;b&gt;denselben MCP-Server&lt;/b&gt;. Du &#228;nderst die Bewertungslogik an einer Stelle &#8212; in Markdown &#8212; und beide Wege ziehen nach." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;fontSize=14;fontColor=#BF360C;" vertex="1" parent="1"><mxGeometry x="40" y="705" width="1520" height="55" as="geometry" /></mxCell>

