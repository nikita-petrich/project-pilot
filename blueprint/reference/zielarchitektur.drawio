<mxfile host="app.diagrams.net" agent="project-pilot" version="24.0.0">
  <diagram id="ziel" name="Zielarchitektur - Claude-App als Oberflaeche">
    <mxGraphModel dx="1700" dy="1150" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1660" pageHeight="1120" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />

        <mxCell id="T" value="Keine eigene App: Die Claude-App IST Feed, Thread und Benachrichtigung. Du baust nur Worker, Skills und MCP-Server." style="text;html=1;align=center;fontSize=17;fontStyle=1;fontColor=#37474F;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1580" height="30" as="geometry" /></mxCell>

        <mxCell id="NIK" value="NIK &#8212; nur Ger&#228;te und Apps, die du schon hast" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#A5D6A7;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fontColor=#1B5E20;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1580" height="200" as="geometry" /></mxCell>
        <mxCell id="n1" value="&lt;b&gt;Handy: Claude-App&lt;/b&gt;&lt;br&gt;&lt;b&gt;4&lt;/b&gt; Push: &#8222;&#11088; 87 &#183; Senior Python &#183; ACME&#8220;&lt;br&gt;&lt;b&gt;5&lt;/b&gt; Tipp &#8594; Session &#246;ffnet sich als Chat" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="120" width="330" height="90" as="geometry" /></mxCell>
        <mxCell id="n2" value="&lt;b&gt;Laptop: claude.ai/code + Desktop-App&lt;/b&gt;&lt;br&gt;Code-Tab = &lt;b&gt;Feed&lt;/b&gt;: Session-Liste, Titel tragen&lt;br&gt;Score &#183; Rolle &#183; Firma &#183; Status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="120" width="360" height="90" as="geometry" /></mxCell>
        <mxCell id="n3" value="&lt;b&gt;Jeder Claude-Chat&lt;/b&gt;&lt;br&gt;Custom Connector (dein MCP):&lt;br&gt;&#8222;zeig Matches von heute&#8220;, &#8222;Status #42?&#8220;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=12;" vertex="1" parent="1"><mxGeometry x="890" y="120" width="330" height="90" as="geometry" /></mxCell>
        <mxCell id="n4" value="&lt;b&gt;Terminal: Claude Code im Repo&lt;/b&gt;&lt;br&gt;gleiche Skills, gleiche Tools&lt;br&gt;&#8594; Dev- und Test-Oberfl&#228;che" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#90A4AE;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1280" y="120" width="300" height="90" as="geometry" /></mxCell>

        <mxCell id="CLOUD" value="ANTHROPIC CLOUD &#8212; l&#228;uft &#252;ber dein Max-Abo, kein API-Metering" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#7E57C2;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fontColor=#4527A0;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="1580" height="230" as="geometry" /></mxCell>
        <mxCell id="rt" value="&lt;b&gt;Routine &#8222;match-thread&#8220;&lt;/b&gt;&#160;(einmal konfiguriert)&lt;br&gt;Repo project-pilot + dein MCP-Connector + Prompt&lt;br&gt;Benachrichtigung: Push + E-Mail bei Abschluss" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1C4E9;strokeColor=#5E35B1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="350" width="400" height="90" as="geometry" /></mxCell>
        <mxCell id="sess" value="&lt;b&gt;3&lt;/b&gt;&#160;&lt;b&gt;1 Session = 1 Match = 1 Thread&lt;/b&gt;&lt;br&gt;Repo ausgecheckt &#8594; .claude/skills laden automatisch&lt;br&gt;liest Match per MCP &#8594; kompakte Analyse &#8594; benennt sich um &#8594; stoppt&lt;br&gt;&lt;i&gt;danach: dein Chat &#8212; &#8222;/check-project&#8220;, &#8222;mach die Mail so und so&#8220;, Freitext&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1C4E9;strokeColor=#5E35B1;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="340" width="520" height="110" as="geometry" /></mxCell>
        <mxCell id="skillsnote" value="&lt;b&gt;Skills = Urteil&lt;/b&gt;&#160;(im Repo, git-versioniert)&lt;br&gt;check-project &#183; write-application&lt;br&gt;research-company &#183; linkedin-outreach&lt;br&gt;&lt;i&gt;auch als /befehl aufrufbar &#8212; deine &#8222;Commands&#8220;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1120" y="340" width="460" height="110" as="geometry" /></mxCell>
        <mxCell id="futurenote" value="&lt;b&gt;Sp&#228;ter, gleiche Basis:&lt;/b&gt;&#160;&#160;Autopilot-Toggle = Worker ruft send-Pfad selbst (Gate per Config) &#160;&#183;&#160; Notion-Sales-Pipeline = Notion-Connector an derselben Routine &#160;&#183;&#160; Feed-Karten in der Claude-App per MCP Apps (seit 01/2026 offiziell) &#160;&#183;&#160; eigene Web-Inbox nur falls Session-Feed nicht reicht &#8212; Worker, Skills, MCP bleiben identisch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#8E24AA;fontSize=11;fontColor=#4A148C;" vertex="1" parent="1"><mxGeometry x="80" y="465" width="1500" height="50" as="geometry" /></mxCell>

        <mxCell id="VPS" value="DEIN VPS &#8212; unver&#228;ndert der bew&#228;hrte Kern" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#FFB74D;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=13;fontStyle=1;fontColor=#E65100;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="1580" height="240" as="geometry" /></mxCell>
        <mxCell id="worker" value="&lt;b&gt;Worker (bleibt!)&lt;/b&gt;&lt;br&gt;Scan alle 15 min &#183; Dedupe &#183; Watermark&lt;br&gt;Hard Rules (0 Token) &#183; LLM-Verdict&lt;br&gt;&lt;i&gt;compliant, getestet &#8212; Neuschreiben br&#228;chte nichts&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="610" width="380" height="100" as="geometry" /></mxCell>
        <mxCell id="fire" value="&lt;b&gt;2&lt;/b&gt;&#160;&lt;b&gt;Match &#8594; Routine feuern&lt;/b&gt;&lt;br&gt;POST .../routines/{id}/fire&lt;br&gt;{text: kompakte Match-Daten}&lt;br&gt;&lt;i&gt;ersetzt den Slack-Notifier &#8212; ein kleines Modul&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="610" width="330" height="100" as="geometry" /></mxCell>
        <mxCell id="mcp" value="&lt;b&gt;MCP-Server&lt;/b&gt;&#160;(FastMCP, &#246;ffentlich + Token)&lt;br&gt;get_listing &#183; search_listings &#183; ingest_listing&lt;br&gt;save_draft &#183; send_application &#183; enrich_company&lt;br&gt;&lt;i&gt;eine Schnittstelle f&#252;r Sessions, Chats, n8n&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#388E3C;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="910" y="610" width="360" height="100" as="geometry" /></mxCell>
        <mxCell id="pg" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;listings &#183; evaluations&lt;br&gt;applications &#183; contact_leads" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFD8DC;strokeColor=#546E7A;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1330" y="610" width="250" height="100" as="geometry" /></mxCell>
        <mxCell id="evals" value="&lt;b&gt;Eval-Suite&lt;/b&gt;: Golden-Set aus evaluations (von dir gelabelt) &#183; pytest-Runner &#183; CI-Gate &#8212; misst, ob Skill-&#196;nderungen das Urteil verbessern oder verschlechtern" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#7B1FA2;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="730" width="770 " height="50" as="geometry" /></mxCell>
        <mxCell id="n8n" value="&lt;b&gt;n8n&lt;/b&gt;: Gmail-Trigger &#8594; MCP Client Node &#8594; ingest/check &#8212; landet im selben Feed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="890" y="730" width="690" height="50" as="geometry" /></mxCell>

        <mxCell id="EXT" value="AUSSENWELT:&#160;&#160;freelancermap (robots-aware, Cooldown bei 403)&#160;&#160;&#183;&#160;&#160;&lt;b&gt;1&lt;/b&gt; neue Listings &#8594; Worker&#160;&#160;&#183;&#160;&#160;SMTP + Google Drive (CVs) &#8212; &lt;b&gt;6&lt;/b&gt; Versand NUR nach deinem Confirm im Thread (Lethal-Trifecta-Regel: Agent liest fremden Text, also sendet er nie selbst)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#90A4AE;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="830" width="1580" height="60" as="geometry" /></mxCell>

        <mxCell id="RISK" value="&lt;b&gt;Ehrliche Kosten dieses Wegs:&lt;/b&gt;&#160;&#160;Routine-API ist experimentell (Beta-Header, Shapes k&#246;nnen sich &#228;ndern) &#8212; betrifft aber nur das kleine fire-Modul &#160;&#183;&#160; Feed ist eine Session-Liste, keine ma&#223;geschneiderten Karten &#8212; Titel tragen die Kurzinfo, MCP Apps ist der Upgrade-Pfad &#160;&#183;&#160; Routine-Runs haben ein Tageskontingent &#8212; bei 2&#8211;5 Matches/Tag unkritisch, und es feuert nur bei echtem Match" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C62828;fontSize=11;fontColor=#B71C1C;" vertex="1" parent="1"><mxGeometry x="40" y="915" width="1580" height="60" as="geometry" /></mxCell>

        <mxCell id="STAGE" value="&lt;b&gt;Reihenfolge:&lt;/b&gt;&#160;&#160;P0 Skills schreiben, in Claude Code testen&#160;&#160;&#8594;&#160;&#160;P1 MCP-Server + als Connector einbinden&#160;&#160;&#8594;&#160;&#160;P2 Eval-Suite&#160;&#160;&#8594;&#160;&#160;P3 Routine anlegen, per curl testen&#160;&#160;&#8594;&#160;&#160;P4 Worker feuert Routine statt Slack (2 Wochen parallel)&#160;&#160;&#8594;&#160;&#160;P5 Slack abbauen&#160;&#160;&#8594;&#160;&#160;sp&#228;ter: Autopilot &#183; Notion &#183; MCP-App-Karten" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=2;fontSize=13;fontColor=#BF360C;" vertex="1" parent="1"><mxGeometry x="40" y="1000" width="1580" height="55" as="geometry" /></mxCell>

        <mxCell id="e1" value="2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#E65100;endArrow=block;strokeWidth=2;fontSize=11;fontStyle=1;" edge="1" parent="1" source="fire" target="rt"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="3&#160;&#160;erzeugt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5E35B1;endArrow=block;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="rt" target="sess"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="4&#160;&#160;Push bei Abschluss" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2E7D32;endArrow=block;strokeWidth=3;fontSize=11;fontStyle=1;" edge="1" parent="1" source="sess" target="n1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="gleiche Session, gro&#223;er Schirm" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2E7D32;endArrow=block;dashed=1;fontSize=10;" edge="1" parent="1" source="sess" target="n2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="Tool-Calls" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#388E3C;endArrow=block;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="sess" target="mcp"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#388E3C;endArrow=block;" edge="1" parent="1" source="n3" target="mcp"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;endArrow=block;" edge="1" parent="1" source="mcp" target="pg"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;endArrow=block;" edge="1" parent="1" source="worker" target="fire"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;endArrow=block;dashed=1;" edge="1" parent="1" source="worker" target="pg"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
