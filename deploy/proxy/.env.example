# Copy to .env next to compose.yaml on the server. Two values, no secrets.

# The public hostname of the MCP server. Its A/AAAA record must already point at
# this VPS before the first `docker compose up -d`, or Let's Encrypt cannot issue.
MCP_DOMAIN=mcp.example.com

# Where Let's Encrypt sends expiry warnings.
ACME_EMAIL=you@example.com

# Only if project-pilot's MCP_PORT was changed from its default.
# MCP_PORT=8765
