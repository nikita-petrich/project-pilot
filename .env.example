# --- Database ---
DATABASE_URL=postgresql+asyncpg://pilot:pilot@localhost:5432/project_pilot

# --- Identity / compliance ---
CONTACT_MAIL=you@example.com

# --- Slack (create an app at api.slack.com/apps; enable Socket Mode) ---
SLACK_BOT_TOKEN=      # xoxb-… bot token (scopes: chat:write, commands)
SLACK_APP_TOKEN=      # xapp-… app-level token (scope: connections:write) for Socket Mode
SLACK_CHANNEL=        # channel id (e.g. C0123ABCD) or #name to post matches/drafts to


# --- LLM ---
OPENAI_API_KEY=
LLM_MODEL=

# --- Behavior ---
SCAN_INTERVAL_MIN=15
ANALYSIS_WINDOW_MIN=30
MATCH_THRESHOLD=60
SEARCH_URLS=
LOG_LEVEL=info

# --- SMTP (application e-mails; sender defaults to SMTP_USER) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
