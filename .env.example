# --- Database ---
DATABASE_URL=postgresql+asyncpg://pilot:pilot@localhost:5432/project_pilot

# --- Identity / compliance ---
CONTACT_MAIL=you@example.com

# --- Slack (create an app at api.slack.com/apps; enable Socket Mode) ---
SLACK_BOT_TOKEN=      # xoxb-… bot token (scopes: chat:write, commands, channels:history, files:read)
SLACK_APP_TOKEN=      # xapp-… app-level token (scope: connections:write) for Socket Mode
SLACK_CHANNEL=        # channel id (e.g. C0123ABCD) or #name to post matches/drafts to


# --- LLM ---
OPENAI_API_KEY=
LLM_MODEL=

# --- Behavior ---
SCAN_INTERVAL_MIN=15
ANALYSIS_WINDOW_MIN=30
MATCH_THRESHOLD=60
SEARCH_URLS=
LOG_LEVEL=info

# --- Contact enrichment (optional; find a company's e-mail/phone from its website) ---
# Opt-in: when off, no company websites are ever fetched. LinkedIn/Google are only
# ever offered as links to open in your browser — never scraped.
ENRICHMENT_ENABLED=false      # true wires the "🔎 Find contact" button + auto-fetch
ENRICHMENT_SEARCH=duckduckgo  # duckduckgo (find the site) | none (only a supplied URL)
ENRICHMENT_MAX_PAGES=6        # per company: homepage + Impressum/Kontakt/Team/Karriere
# Render JS-heavy sites with a headless browser (needs the 'render' extra + a browser:
#   uv sync --extra render && uv run playwright install chromium). Off = fast httpx only.
ENRICHMENT_RENDER=false
ENRICHMENT_RENDER_BROWSER_PATH=   # optional: explicit Chromium path if not auto-found
# The LinkedIn connection message signs with your name from profile.md
# (Contact & Signature) — no separate setting needed.
# Offer the recipient first-name terms ("Gerne auch per Du.") in the connection message.
OUTREACH_OFFER_DU=true

# --- SMTP (application e-mails; sender defaults to SMTP_USER) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# --- CV attachments (every configured CV is attached to every application) ---
# Leave these unset: they default to the CVs versioned in cv/, so updating a CV means
# replacing the file in that directory and pushing. The file name is what the
# recipient sees. All of them go out on every send; the draft language only decides
# the order. A configured file that is missing on disk is skipped and reported in the
# draft. Override only to point somewhere else; set one to an empty value to leave
# that CV out.
# CV_DE_PATH=cv/CV-German.pdf
# CV_EN_PATH=cv/CV-English.pdf
# The Word slots are unset by default (no .docx is versioned); set them only if you add one.
# CV_DE_DOCX_PATH=
# CV_EN_DOCX_PATH=
