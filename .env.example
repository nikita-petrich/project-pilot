# --- Database ---
DATABASE_URL=postgresql+asyncpg://pilot:pilot@localhost:5432/project_pilot

# --- Identity / compliance ---
CONTACT_MAIL=you@example.com

# --- Telegram (create the bot via @BotFather) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- LLM ---
OPENAI_API_KEY=
LLM_MODEL=

# --- Behavior ---
SCAN_INTERVAL_MIN=15
ANALYSIS_WINDOW_MIN=30
MATCH_THRESHOLD=60
SEARCH_URLS=
LOG_LEVEL=info

# --- SMTP (application e-mails; sender defaults to SMTP_USER) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
