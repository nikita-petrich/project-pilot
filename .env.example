# --- Database ---
DATABASE_URL=postgresql+asyncpg://pilot:pilot@localhost:5432/project_pilot

# --- Identity / compliance ---
CONTACT_MAIL=you@example.com

# --- LLM ---
# Which API the matcher (stage 3) and the application drafts call. Both adapters
# ship in the image, so switching is this one line plus the matching key — but the
# prompt is tuned per model, so re-run the golden set after a switch:
#   LLM_PROVIDER=... LLM_MODEL=... uv run pytest -m eval
LLM_PROVIDER=openai   # openai | anthropic
# Only the selected provider's key is required; keeping both lets you switch back.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Model name for the selected provider, e.g. gpt-5.6-luna on openai, or
# claude-opus-5 / claude-sonnet-5 on anthropic.
LLM_MODEL=
# How deeply the model reasons before answering (low | medium | high | xhigh | max),
# sent as `reasoning_effort` on openai and `output_config.effort` on anthropic. Leave
# it empty to not send the parameter at all — required for any model that does not
# know it, which is why empty is the default. On a model that reasons by default,
# 'low' is what keeps the answer (and the bill) from being mostly reasoning.
LLM_EFFORT=

# --- Behavior ---
SCAN_INTERVAL_MIN=15
ANALYSIS_WINDOW_MIN=30
MATCH_THRESHOLD=60
SEARCH_URLS=
LOG_LEVEL=info

# --- Profile ---------------------------------------------------------------
# The profile is not kept in this repository: it is read from the website at
# boot (the markdown twin /<locale>.md plus /api/profile.json). Only the private
# half — the no-go industries and technologies — lives here, in
# profile/private.yaml. A failed fetch aborts and warns on Telegram; there is no
# fallback to an older copy.
PROFILE_URL=https://sequenz.io
PROFILE_LOCALE=en

# --- Contact enrichment (find a company's e-mail/phone from its own website) ---
# Always on: the apply flow needs a recipient, and looking one up by hand is the
# step this removes. LinkedIn/Google are only ever offered as links to open in
# your browser — never scraped.
ENRICHMENT_SEARCH=duckduckgo  # duckduckgo (find the site) | none (only a supplied URL)
ENRICHMENT_MAX_PAGES=6        # per company: homepage + Impressum/Kontakt/Team/Karriere
# Render JS-heavy sites with a headless browser (needs the 'render' extra + a browser:
#   uv sync --extra render && uv run playwright install chromium). Off = fast httpx only.
ENRICHMENT_RENDER=false
ENRICHMENT_RENDER_BROWSER_PATH=   # optional: explicit Chromium path if not auto-found
# The LinkedIn connection message signs with your name from the profile
# (Contact & Signature) — no separate setting needed.
# Offer the recipient first-name terms ("Gerne auch per Du.") in the connection message.
OUTREACH_OFFER_DU=true

# --- SMTP (application e-mails; sender defaults to SMTP_USER) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Leave true. Disabling STARTTLS on any port other than 465 sends your SMTP
# credentials and the application e-mail in clear text — only turn it off for a
# trusted local relay you control.
SMTP_STARTTLS=true

# --- CV attachments (both CV PDFs are attached to every application) ---
# The CVs are pulled from a public Google Drive folder by file name and cached
# locally before each draft and send, so updating a CV means replacing the file in
# Drive — no commit, no redeploy. Leave everything unset for the defaults below.
# CV_DRIVE_FOLDER_ID is the public folder; the file names (the basenames of
# CV_DE_PATH/CV_EN_PATH) are both the Drive lookup keys and what the recipient sees.
# Both CVs go out on every send; the draft language only decides the order. If Drive
# is unreachable, the last cached copy is used; a CV that can be fetched from neither
# is skipped and reported in the draft. Set CV_DRIVE_FOLDER_ID empty to use plain
# local files instead, or a CV_*_PATH empty to leave that CV out.
# CV_DRIVE_FOLDER_ID=1zfW069MqEkocmr8HXvnves4GI9xzXd0y
# CV_DE_PATH=cv/CV-German.pdf
# CV_EN_PATH=cv/CV-English.pdf

# --- MCP server (feature 20) ---------------------------------------------------
# Bearer token every MCP client must send (Claude custom connector, match
# session, n8n). Generate e.g. with: openssl rand -hex 32. Empty = server refuses
# to start.
MCP_TOKEN=
# Port the MCP server listens on inside the container (compose maps it 1:1).
MCP_PORT=8765
# The Docker network the reverse proxy runs on, so it can reach the MCP container
# by name (project-pilot-mcp). `docker network ls` on the server names it. Only
# used by compose.prod.yaml on the VPS; irrelevant locally.
PROXY_NETWORK=edge

# --- Match alert: Telegram (feature 27) ------------------------------------------
# THE alert channel (required): every match is sent straight from the worker,
# seconds after the verdict, as one HTTP POST with retry. Operator warnings
# travel the same way. The card carries three buttons: the original listing
# and a new Claude chat (a claude.ai/new?q= link with the card in its prompt)
# are plain links; Ablehnen is heard by the `telegram-bot` process
# (long polling, no inbound port), which deletes the card.
# The bot token from @BotFather (digits, colon, secret).
TELEGRAM_BOT_TOKEN=
# Your private chat with the bot: message the bot once, then read the id from
# getUpdates (see docs/claude-setup.md). A positive number.
TELEGRAM_CHAT_ID=
# The page the Bewerben button opens with the card prefilled (its q parameter):
# a new Claude chat. Set https://claude.ai/code/new to open a Code session
# instead (the documented fallback, needs GitHub connected on claude.ai/code).
CLAUDE_SESSION_URL=https://claude.ai/new
